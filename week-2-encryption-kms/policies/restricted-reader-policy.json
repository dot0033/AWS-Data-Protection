{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRestrictedBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::RESTRICTED_BUCKET", "arn:aws:s3:::RESTRICTED_BUCKET/*"]
    },
    {
      "Sid": "DecryptWithRestrictedKeyViaS3",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "RESTRICTED_KEY_ARN",
      "Condition": {"StringEquals": {"kms:ViaService": "s3.eu-central-1.amazonaws.com"}}
    }
  ]
}
